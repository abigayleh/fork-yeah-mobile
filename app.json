{
  "expo": {
    "name": "fork-yeah-mobile",
    "slug": "fork-yeah-mobile",
    "scheme": "forkyeah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hammyinc.whatsfordinner",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "forkyeah",
              "com.googleusercontent.apps.888702110970-ua103f1surn435l2tpsdk6v20ic90gf1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.hammyinc.whatsfordinner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Fork Yeah to use Face ID to unlock the app."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83d962f8-76af-409c-b8c9-e03a7aebc839"
      }
    }
  }
}
